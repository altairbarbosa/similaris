# Microsoft Store publishing credentials.
# Copy this file to .env.local for local use. Do not commit real values.

# Public product identifiers. These may also live in docs or manifests.
SIMILARIS_STORE_ID=9NMSQ0XLNH7S
SIMILARIS_STORE_URL=https://apps.microsoft.com/detail/9NMSQ0XLNH7S
SIMILARIS_STORE_PROTOCOL_LINK=ms-windows-store://pdp/?productid=9NMSQ0XLNH7S

# Partner Center / Entra credentials for automated publishing.
SIMILARIS_PARTNER_TENANT_ID=
SIMILARIS_PARTNER_CLIENT_ID=
SIMILARIS_PARTNER_CLIENT_SECRET=

# Optional signing certificate for local sideload packages.
SIMILARIS_SIGNING_CERTIFICATE_PATH=
SIMILARIS_SIGNING_CERTIFICATE_PASSWORD=
